# ---------------------------------------------------------------- gateway ---
AIGW_PORT=8787
AIGW_HOST=0.0.0.0
AIGW_DATA_DIR=~/.ai-gateway
# Shared secret the client agents present on the WebSocket upgrade.
AIGW_AGENT_TOKEN=change-me

# Require an API key on /v1/*. Off by default so a local setup works immediately.
AIGW_REQUIRE_API_KEY=false
AIGW_API_KEY=sk-local-dev

# Liveness: a client is evicted after MISS_TOLERANCE missed heartbeats.
AIGW_HEARTBEAT_INTERVAL_MS=10000
AIGW_HEARTBEAT_MISS_TOLERANCE=3
# How long a client has to acknowledge a dispatched job before it is re-routed.
AIGW_DISPATCH_ACK_TIMEOUT_MS=10000
AIGW_JOB_TIMEOUT_MS=300000
AIGW_MAX_ROUTE_ATTEMPTS=3
# Hold a request this long waiting for a capable client to appear.
AIGW_QUEUE_WAIT_MS=15000

AIGW_CACHE_ENABLED=true
AIGW_CACHE_TTL_MS=600000
AIGW_CACHE_MAX_ENTRIES=500

# least-busy | round-robin | fill-first
AIGW_ROUTING_STRATEGY=least-busy
AIGW_LOG_LEVEL=info

# ----------------------------------------------------------- client agent ---
AIGW_SERVER_URL=ws://127.0.0.1:8787/agent
# AIGW_AGENT_ID=my-laptop        # defaults to a generated, persisted id
# AIGW_AGENT_NAME=my-laptop
AIGW_MAX_CONCURRENCY=4
AIGW_CAPABILITY_SCAN_MS=15000

# Browser backend: attach to a Chrome started with --remote-debugging-port.
AIGW_BROWSER_ENABLED=true
AIGW_CDP_URL=http://127.0.0.1:9222
# Chrome profile directory the browser backend attaches to - dedicated,
# never your personal Chrome profile. Created on first `npm run chrome`.
# AIGW_CHROME_PROFILE=~/.ai-gateway-client/chrome-profile
# Comma-separated allowlist; empty means every known provider.
# AIGW_BROWSER_PROVIDERS=chatgpt,claude,gemini
AIGW_BROWSER_CONCURRENCY=1
AIGW_BROWSER_AUTO_OPEN_TAB=false

# CLI backend: spawns locally installed coding CLIs.
AIGW_CLI_ENABLED=true
AIGW_CLI_CONCURRENCY=2
# AIGW_CLI_CWD=/path/to/your/project
AIGW_CLI_TIMEOUT_MS=300000
# Enable the deterministic test adapter: AIGW_CLI_EXTRA=echo
